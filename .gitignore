# Secrets
.env
.env.*
.aider*

# WireGuard material generated by rdp_tunnel/setup_wireguard.sh --
# wg-rdp*.conf embed PrivateKey inline. Never commit these.
*.key
*.pem
wg-rdp.conf
wg-rdp-client.conf

# Selenium profile regenerated by enter_shifts.py (user-data-dir=./Default).
# Holds live session cookies for whatever the script logs into.
Default/

# Runtime output. NOTE: /*.log is root-scoped on purpose --
# fixtures/sample-ping.log is a TEST INPUT (test_analyze.sh) and must stay tracked.
logs/
/*.log
